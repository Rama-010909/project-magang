rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Mode demo/project: aplikasi memakai login demo sendiri,
    // bukan Firebase Authentication.
    match /assets/{document=**} {
      allow read, write: if true;
    }
    match /maintenance/{document=**} {
      allow read, write: if true;
    }
  }
}
