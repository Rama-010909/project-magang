# Isi ini sebagai Environment Variables di Vercel Project Settings
# (BUKAN file .env yang di-commit ke Git - ini cuma contoh/dokumentasi).

# Seluruh isi JSON Service Account dari:
# Firebase Console > Project Settings > Service Accounts > Generate new private key
# Tempel APA ADANYA sebagai satu string JSON (boleh multi-baris, Vercel bisa terima).
FIREBASE_SERVICE_ACCOUNT=CHANGE_ME_TEMPEL_ISI_JSON_SERVICE_ACCOUNT_DI_SINI

# String acak panjang buatan sendiri. Harus SAMA PERSIS dengan secret
# CRON_SECRET yang kamu isi di GitHub repo (Settings > Secrets and variables
# > Actions). Ini kunci supaya cuma GitHub Actions kamu yang bisa memicu
# pengiriman notifikasi (orang lain yang buka endpoint ini cuma dapat data
# baca biasa, tidak bisa memicu kirim notifikasi).
CRON_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
